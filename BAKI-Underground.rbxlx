<?xml version='1.0' encoding='utf-8'?>
<roblox version="4">
  <Item class="Workspace" referent="RBX1">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
